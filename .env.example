# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=Log

# --- MySQL (matches docker-compose.yml) ---
MYSQL_HOST=127.0.0.1
# 3307, not 3306: a Windows MySQL80 service may already own 3306 on the host.
MYSQL_PORT=3307
MYSQL_DB=agent007
MYSQL_USER=agent007
MYSQL_PASSWORD=change-me
# Used only by the docker-compose MySQL container on first start
MYSQL_ROOT_PASSWORD=change-me-root

# --- Kafka (matches docker-compose.yml) ---
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CLIENT_ID=agent007

# --- Telegram API ---
# Obtain at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
